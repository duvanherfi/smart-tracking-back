/ = form_with model: Session, url: sessions_path do |f|
/
/   .mb-4
/     = f.label :email, class: "block text-sm font-medium text-gray-700 dark:text-gray-200"
/     = f.email_field :email, class: "form-input mt-1 block w-full", required: true, autofocus: true
/
/   .mb-4
/     = f.label :password, class: "block text-sm font-medium text-gray-700 dark:text-gray-200"
/     = f.password_field :password, class: "form-input mt-1 block w-full", required: true
/
/   .mb-4
/     = f.submit "Log in", class: "btn btn-primary w-full"
/
/   .mt-4.text-center
/     = link_to "Forgot your password?", login_sessions_path, class: "text-sm text-gray-600 dark:text-gray-300 hover:text-gray-800 dark:hover:text-gray-100"
/
/   .mt-4.text-center
/     = link_to "Back to home", root_path, class: "text-sm text-gray-600 dark:text-gray-300 hover:text-gray-800 dark:hover:text-gray-100"

div class="bg-white rounded-lg shadow-lg p-8 w-96"
  h1 class="text-2xl font-bold text-center mb-6" SMART TRACKING
  div class="mb-4"
    label class="block text-gray-700 text-sm font-bold mb-2" for="numero" Número:
    input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="numero" type="text" placeholder="Ingresa tu número"

  div class="mb-6"
    label class="block text-gray-700 text-sm font-bold mb-2" for="contrasena" Contraseña:
    input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline" id="contrasena" type="password" placeholder="Ingresa tu contraseña"

  div class="flex items-center mb-4"
    input type="checkbox" id="terminos" class="mr-2"
    label class="text-sm text-gray-700" for="terminos"
      Aceptar términos y condiciones
      a href="#" class="text-blue-500 hover:underline" presiona aquí para ver

  button class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded w-full focus:outline-none focus:shadow-outline" Iniciar sesión
  div class="text-center mt-4"
    a href="#" class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800" ¿Olvidaste tu contraseña?
