# Copy to .env and fill in. Nothing here is a secret; the real values are.

# Base URL of the upstream GPS provider's API (no trailing path).
GPS_SERVICE=http://gps.example.com/
# Account used to log into that provider. The phone doubles as the username.
GPS_USER=3001112233
GPS_PASSWORD=1234

# Reverse-geocoding service used to label a geofence with a street address.
REVERSE_SERVICE=https://reverse.example.com/

# host:port, not a full URI — mongoid.yml builds the URI around it.
MONGO_URL=localhost:27017
REDIS_URL=redis://localhost:6379/0

# Outgoing mail, only needed for password recovery.
MAILGUN_SMTP_SERVER=
MAILGUN_SMTP_PORT=
MAILGUN_SMTP_LOGIN=
MAILGUN_SMTP_PASSWORD=
MAILGUN_SMTP_DOMAIN=
